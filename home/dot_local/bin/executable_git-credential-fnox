#!/usr/bin/env bash
# git credential helper for git.waltr.tech: answers `get` from fnox (1Password),
# never stores anything. Wired in ~/.config/git/config for that host only.
set -euo pipefail
[[ ${1:-} == get ]] || exit 0
host=
while IFS='=' read -r k v; do
  [[ -z $k ]] && break
  [[ $k == host ]] && host=$v
done
[[ $host == git.waltr.tech ]] || exit 0
printf 'username=rwaltr\npassword=%s\n' "$(fnox get FORGEJO_TOKEN)"
