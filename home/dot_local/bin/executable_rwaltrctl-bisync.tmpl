#!/usr/bin/env bash
# vi: ft=sh
# rwaltrctl bisync — manage bisync profiles, keys, resync, and services.
#
# Usage:
#   rwaltrctl bisync <command> [args...]

{{ if (and (eq .chezmoi.os "linux") (not .headless)) -}}
set -euo pipefail

BISYNC_DIR="{{ .chezmoi.homeDir }}/.config/bisync"
LOCK_DIR="{{ .chezmoi.homeDir }}/.cache/rclone/bisync"
AUTO_BISYNC="{{ .chezmoi.homeDir }}/.local/bin/auto-bisync"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${GREEN}[bisync]${NC} $*"; }
warn()  { echo -e "${YELLOW}[bisync]${NC} $*"; }
error() { echo -e "${RED}[bisync]${NC} $*" >&2; }
step()  { echo -e "\n${CYAN}${BOLD}══ $* ══${NC}"; }

confirm() {
  local msg="$1"
  read -rp "$(echo -e "${YELLOW}${msg} [y/N]${NC} ")" ans
  [[ "$ans" =~ ^[Yy] ]]
}

profile_file() {
  printf '%s/%s.env' "$BISYNC_DIR" "$1"
}

valid_profile_name() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

list_profiles() {
  [[ -d "$BISYNC_DIR" ]] || return 0
  find "$BISYNC_DIR" -maxdepth 1 -type f -name '*.env' -printf '%f\n' \
    | sed 's/\.env$//' \
    | sort
}

profile_exists() {
  [[ -f "$(profile_file "$1")" ]]
}

load_profile() {
  local profile="$1"
  LOCAL=""
  REMOTE=""
  # shellcheck source=/dev/null
  source "$(profile_file "$profile")"
}

extract_key_file() {
  local remote="$1"
  if [[ "$remote" =~ key_file=([^,:]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  fi
}

extract_host() {
  local remote="$1"
  if [[ "$remote" =~ host=([^,:]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  fi
}

is_tailscale_up() {
  command -v tailscale &>/dev/null && tailscale status &>/dev/null
}

is_resynced_any() {
  [[ -d "$LOCK_DIR" ]] && [[ -n "$(ls -A "$LOCK_DIR" 2>/dev/null)" ]]
}

resolve_profiles() {
  local target="${1:-all}"
  local p

  if [[ "$target" == "all" ]]; then
    list_profiles
    return 0
  fi

  if profile_exists "$target"; then
    printf '%s\n' "$target"
    return 0
  fi

  error "Profile not found: $target"
  return 1
}

build_remote_spec() {
  local host="$1"
  local key_file="$2"
  local remote_path="$3"
  printf ':sftp,host=%s,key_file=%s:%s' "$host" "$key_file" "$remote_path"
}

write_profile() {
  local profile="$1"
  local local_path="$2"
  local remote_spec="$3"

  mkdir -p "$BISYNC_DIR"
  local file
  file="$(profile_file "$profile")"

  {
    printf 'LOCAL=%q\n' "$local_path"
    printf 'REMOTE=%q\n' "$remote_spec"
  } > "$file"

  info "Wrote $file"
}

prompt_default() {
  local label="$1"
  local default="${2:-}"
  local value

  if [[ -n "$default" ]]; then
    read -rp "$label [$default]: " value
    printf '%s' "${value:-$default}"
  else
    read -rp "$label: " value
    printf '%s' "$value"
  fi
}

add_cmd() {
  local profile=""
  local local_path=""
  local remote_spec=""
  local host=""
  local key_file="${HOME}/.ssh/id_ed25519"
  local remote_path=""
  local prompt=false
  local force=false

  if [[ $# -gt 0 && "${1:0:1}" != "-" ]]; then
    profile="$1"
    shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile) profile="${2:-}"; shift 2 ;;
      --local) local_path="${2:-}"; shift 2 ;;
      --remote) remote_spec="${2:-}"; shift 2 ;;
      --host) host="${2:-}"; shift 2 ;;
      --key-file) key_file="${2:-}"; shift 2 ;;
      --remote-path) remote_path="${2:-}"; shift 2 ;;
      --prompt) prompt=true; shift ;;
      --force) force=true; shift ;;
      *) error "Unknown option for add: $1"; return 2 ;;
    esac
  done

  if $prompt; then
    profile="$(prompt_default "Profile name" "$profile")"
    local_path="$(prompt_default "Local path" "$local_path")"
    remote_spec="$(prompt_default "Remote spec (leave blank to build from host/path)" "$remote_spec")"
    if [[ -z "$remote_spec" ]]; then
      host="$(prompt_default "Remote host" "$host")"
      key_file="$(prompt_default "SSH key file" "$key_file")"
      remote_path="$(prompt_default "Remote path" "$remote_path")"
    fi
  fi

  if ! valid_profile_name "$profile"; then
    error "Invalid profile name: '$profile'"
    return 2
  fi

  if profile_exists "$profile" && ! $force; then
    error "Profile already exists: $profile (use --force to overwrite or use edit)"
    return 1
  fi

  if [[ -z "$remote_spec" && -n "$host" && -n "$remote_path" ]]; then
    remote_spec="$(build_remote_spec "$host" "$key_file" "$remote_path")"
  fi

  if [[ -z "$local_path" || -z "$remote_spec" ]]; then
    error "add requires LOCAL and REMOTE (or host/key-file/remote-path)"
    return 2
  fi

  write_profile "$profile" "$local_path" "$remote_spec"
}

edit_cmd() {
  local profile="${1:-}"
  shift || true

  if [[ -z "$profile" || "${profile:0:1}" == "-" ]]; then
    error "Usage: rwaltrctl bisync edit <profile> [options]"
    return 2
  fi

  if ! profile_exists "$profile"; then
    error "Profile not found: $profile"
    return 1
  fi

  load_profile "$profile"

  add_cmd --profile "$profile" --local "$LOCAL" --remote "$REMOTE" --force "$@"
}

remove_cmd() {
  local profile="${1:-}"
  shift || true
  local yes=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes) yes=true; shift ;;
      *) error "Unknown option for remove: $1"; return 2 ;;
    esac
  done

  if [[ -z "$profile" ]]; then
    error "Usage: rwaltrctl bisync remove <profile> [--yes]"
    return 2
  fi

  if ! profile_exists "$profile"; then
    error "Profile not found: $profile"
    return 1
  fi

  if ! $yes; then
    confirm "Remove profile '$profile'?" || return 0
  fi

  rm -f "$(profile_file "$profile")"
  info "Removed profile '$profile'"
}

list_cmd() {
  local p
  step "Bisync profiles"
  if ! list_profiles | grep -q '.'; then
    info "No profiles found in $BISYNC_DIR"
    return 0
  fi

  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    load_profile "$p"
    echo -e "\n  ${CYAN}${p}${NC}"
    echo "    Local:  ${LOCAL:-<unset>}"
    echo "    Remote: ${REMOTE:-<unset>}"
    if [[ -n "${REMOTE:-}" ]]; then
      echo "    Host:   $(extract_host "$REMOTE")"
      echo "    Key:    $(extract_key_file "$REMOTE")"
    fi
  done < <(list_profiles)
  echo ""
}

status_cmd() {
  local target="${1:-all}"
  local p key
  local -a profiles

  mapfile -t profiles < <(resolve_profiles "$target")
  step "Bisync status"

  if [[ ${#profiles[@]} -eq 0 ]]; then
    info "No profiles configured"
    return 0
  fi

  if is_tailscale_up; then
    info "Tailscale: connected"
  else
    warn "Tailscale: not connected"
  fi

  if is_resynced_any; then
    info "Initial resync state: detected"
  else
    warn "Initial resync state: not detected"
  fi

  for p in "${profiles[@]}"; do
    load_profile "$p"
    key="$(extract_key_file "${REMOTE:-}")"

    echo ""
    echo "Profile: $p"
    echo "  Local:  ${LOCAL:-<unset>}"
    echo "  Remote: ${REMOTE:-<unset>}"

    if [[ -n "$key" && -f "$key" ]]; then
      echo "  Key:    ready ($key)"
    elif [[ -n "$key" ]]; then
      echo "  Key:    missing ($key)"
    else
      echo "  Key:    not declared"
    fi

    if systemctl --user is-enabled "bisync@${p}.service" &>/dev/null; then
      if systemctl --user is-active "bisync@${p}.service" &>/dev/null; then
        echo "  Service: enabled + active"
      else
        echo "  Service: enabled + inactive"
      fi
    else
      echo "  Service: disabled"
    fi
  done

  echo ""
}

setup_keys_cmd() {
  local target="${1:-all}"
  local p key pub comment
  local -a profiles

  mapfile -t profiles < <(resolve_profiles "$target")
  step "Setup bisync SSH keys"

  for p in "${profiles[@]}"; do
    load_profile "$p"
    key="$(extract_key_file "${REMOTE:-}")"
    if [[ -z "$key" ]]; then
      warn "$p: no key_file in REMOTE"
      continue
    fi

    if [[ -f "$key" ]]; then
      info "$p: key exists ($key)"
      continue
    fi

    comment="${USER}@$(hostname)-bisync-${p}"
    mkdir -p "$(dirname "$key")"
    chmod 700 "$(dirname "$key")"
    ssh-keygen -t ed25519 -f "$key" -C "$comment" -N ""
    chmod 600 "$key"
    pub="${key}.pub"
    chmod 644 "$pub"
    info "$p: created key $key"
  done
}

install_remote_keys_cmd() {
  local target="${1:-all}"
  local p host key pub
  local -a profiles

  mapfile -t profiles < <(resolve_profiles "$target")
  step "Install SSH keys on remote hosts"

  if ! is_tailscale_up; then
    warn "Tailscale is not connected"
    return 1
  fi

  for p in "${profiles[@]}"; do
    load_profile "$p"
    host="$(extract_host "${REMOTE:-}")"
    key="$(extract_key_file "${REMOTE:-}")"

    if [[ -z "$host" || -z "$key" ]]; then
      warn "$p: missing host or key_file in REMOTE"
      continue
    fi

    pub="${key}.pub"
    if [[ ! -f "$pub" ]]; then
      warn "$p: missing public key $pub (run setup-keys first)"
      continue
    fi

    info "$p: installing key on $host"
    if command -v ssh-copy-id &>/dev/null; then
      if ssh-copy-id -i "$pub" "$host"; then
        info "$p: installed via ssh-copy-id"
        continue
      fi
    fi

    if ssh "$host" 'umask 077; mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys' < "$pub"; then
      info "$p: installed key on $host"
    else
      warn "$p: failed to install key on $host"
    fi
  done
}

resync_cmd() {
  local target="${1:-all}"
  local p key
  local -a profiles

  mapfile -t profiles < <(resolve_profiles "$target")
  step "Initial bisync resync"

  if ! command -v "$AUTO_BISYNC" &>/dev/null; then
    error "auto-bisync not found: $AUTO_BISYNC"
    return 127
  fi

  if ! is_tailscale_up; then
    warn "Tailscale is not connected"
    return 1
  fi

  for p in "${profiles[@]}"; do
    load_profile "$p"
    key="$(extract_key_file "${REMOTE:-}")"

    if [[ -n "$key" && ! -f "$key" ]]; then
      warn "$p: missing key $key"
      continue
    fi

    if [[ -z "${LOCAL:-}" || -z "${REMOTE:-}" ]]; then
      warn "$p: LOCAL or REMOTE unset"
      continue
    fi

    info "$p: resyncing ${LOCAL} ↔ ${REMOTE}"
    "$AUTO_BISYNC" "$LOCAL" "$REMOTE" resync || warn "$p: resync failed"
  done
}

enable_service_cmd() {
  local target="${1:-all}"
  local p
  local -a profiles

  mapfile -t profiles < <(resolve_profiles "$target")
  step "Enable bisync services"

  for p in "${profiles[@]}"; do
    info "Enabling bisync@${p}.service"
    systemctl --user enable --now "bisync@${p}.service"
  done
}

disable_service_cmd() {
  local target="${1:-all}"
  local p
  local -a profiles

  mapfile -t profiles < <(resolve_profiles "$target")
  step "Disable bisync services"

  for p in "${profiles[@]}"; do
    info "Disabling bisync@${p}.service"
    systemctl --user disable --now "bisync@${p}.service" || true
  done
}

wizard_cmd() {
  local profile="${1:-}"

  step "Bisync wizard"
  list_cmd

  if [[ -z "$profile" ]]; then
    profile="$(prompt_default "Profile to configure")"
  fi

  if [[ -z "$profile" ]]; then
    warn "No profile selected"
    return 1
  fi

  if profile_exists "$profile"; then
    info "Editing existing profile: $profile"
    edit_cmd "$profile" --prompt
  else
    info "Creating new profile: $profile"
    add_cmd "$profile" --prompt
  fi

  if confirm "Generate/setup SSH key for '$profile' now?"; then
    setup_keys_cmd "$profile"
  fi

  if confirm "Install SSH key on remote host now?"; then
    install_remote_keys_cmd "$profile" || true
  fi

  if confirm "Run initial resync now?"; then
    resync_cmd "$profile" || true
  fi

  if confirm "Enable bisync service now?"; then
    enable_service_cmd "$profile"
  fi

  status_cmd "$profile"
}

usage() {
  cat <<'EOF'
Usage:
  rwaltrctl bisync <command> [args...]

Commands:
  status [profile|all]
  list

  add [profile] [--local PATH] [--remote SPEC]
      [--host HOST --key-file PATH --remote-path PATH]
      [--prompt] [--force]
  edit <profile> [same flags as add]
  remove <profile> [--yes]
  wizard [profile]

  setup-keys [profile|all]
  install-remote-keys [profile|all]
  resync [profile|all]
  enable-service [profile|all]
  disable-service [profile|all]
EOF
}

cmd="${1:-}"
shift || true

case "$cmd" in
  -h|--help|help|"") usage ;;
  status) status_cmd "${1:-all}" ;;
  list) list_cmd ;;
  add) add_cmd "$@" ;;
  edit) edit_cmd "$@" ;;
  remove) remove_cmd "$@" ;;
  wizard) wizard_cmd "${1:-}" ;;
  setup-keys) setup_keys_cmd "${1:-all}" ;;
  install-remote-keys) install_remote_keys_cmd "${1:-all}" ;;
  resync) resync_cmd "${1:-all}" ;;
  enable-service) enable_service_cmd "${1:-all}" ;;
  disable-service) disable_service_cmd "${1:-all}" ;;
  *) error "Unknown bisync command: $cmd"; usage; exit 2 ;;
esac
{{- else }}
echo "Skipping bisync plugin (not Linux or headless)"
{{- end }}
