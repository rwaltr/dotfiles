{
  "mcpServers": {
    "agentgateway": {
      "url": "https://llm.waltr.tech/mcp",
      "headers": {
        "Authorization": "!echo Bearer $(fnox get AGENTGATEWAY_API_KEY)"
      },
      "exposure": "codemode",
      "description": "agentgateway MCP multiplex: flux, kubectl, home-assistant, mikrotik"
    },
    "kubernetes": {
      "command": "npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@latest",
        "--config",
        "/var/home/rwaltr/.config/kubernetes-mcp-server.toml"
      ],
      "exposure": "codemode"
    },
    "fnox": {
      "command": "fnox",
      "args": [
        "mcp"
      ],
      "exposure": "codemode",
      "description": "On-demand secret access (get_secret/exec) limited to the [mcp].secrets allowlist"
    },
    "homeassistant": {
      "command": "uvx",
      "args": [
        "ha-mcp@latest"
      ],
      "env": {
        "HOMEASSISTANT_URL": "https://homeassistant.waltr.tech",
        "HOMEASSISTANT_TOKEN": "!fnox get HA_TOKEN"
      },
      "exposure": "codemode",
      "description": "Home Assistant control and introspection (unofficial homeassistant-ai/ha-mcp)"
    }
  }
}
