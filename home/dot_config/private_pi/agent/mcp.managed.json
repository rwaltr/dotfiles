{
  "mcpServers": {
    "kubernetes": {
      "command": "npx",
      "args": [
        "-y",
        "kubernetes-mcp-server@latest",
        "--config",
        "/var/home/rwaltr/.config/kubernetes-mcp-server.toml"
      ],
      "exposure": "codemode"
    },
    "fnox": {
      "command": "fnox",
      "args": [
        "mcp"
      ],
      "exposure": "codemode",
      "description": "On-demand secret access (get_secret/exec) limited to the [mcp].secrets allowlist"
    },
    "grafana": {
      "command": "mcp-grafana",
      "args": [
        "-t",
        "stdio"
      ],
      "env": {
        "GRAFANA_URL": "https://grafana.waltr.tech",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "!fnox get GRAFANA_TOKEN"
      },
      "exposure": "codemode",
      "description": "Grafana dashboards, datasources, metrics, and Loki queries"
    },
    "homeassistant": {
      "command": "uvx",
      "args": [
        "ha-mcp@latest"
      ],
      "env": {
        "HOMEASSISTANT_URL": "https://homeassistant.waltr.tech",
        "HOMEASSISTANT_TOKEN": "!fnox get HA_TOKEN"
      },
      "exposure": "codemode",
      "description": "Home Assistant control and introspection (unofficial homeassistant-ai/ha-mcp)"
    }
  }
}
