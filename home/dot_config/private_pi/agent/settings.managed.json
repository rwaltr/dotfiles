{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "rwaltrpi",
  "defaultModel": "deepseek-v4.1-flash",
  "enabledModels": [
    "rwaltrpi/deepseek-v4.1-flash",
    "rwaltrpi/deepseek-v4-pro",
    "rwaltrpi/kimi-k3",
    "rwaltrpi/glm-5.3",
    "openrouter/openai/gpt-5.3-codex",
    "openrouter/anthropic/claude-sonnet-5",
    "openrouter/anthropic/claude-opus-5",
    "agentgateway/claude-sonnet-5-5",
    "agentgateway/claude-opus-5-5",
    "agentgateway/claude-haiku-5-5"
  ],
  "defaultThinkingLevel": "medium",
  "theme": "dark",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 30000,
    "modelOverrides": {
      "opencode-go/deepseek-v4.1-flash": {
        "reserveTokens": 650000
      },
      "opencode-go/deepseek-v4-pro": {
        "reserveTokens": 650000
      },
      "opencode-go/kimi-k3": {
        "reserveTokens": 650000
      },
      "opencode-go/glm-5.3": {
        "reserveTokens": 650000
      },
      "openrouter/deepseek/deepseek-v4.1-flash": {
        "reserveTokens": 650000
      },
      "openrouter/deepseek/deepseek-v4-flash": {
        "reserveTokens": 650000
      },
      "openrouter/~deepseek/deepseek-flash-latest": {
        "reserveTokens": 650000
      },
      "openrouter/moonshotai/kimi-k3": {
        "reserveTokens": 650000
      },
      "openrouter/z-ai/glm-5.3": {
        "reserveTokens": 650000
      },
      "openrouter/openai/gpt-5.3-codex": {
        "reserveTokens": 150000
      },
      "agentgateway/claude-sonnet-5-5": {
        "reserveTokens": 650000
      },
      "agentgateway/claude-opus-5-5": {
        "reserveTokens": 650000
      },
      "agentgateway/claude-haiku-5-5": {
        "reserveTokens": 650000
      }
    }
  },
  "defaultTools": [
    "+codemode",
    "+tool_search"
  ],
  "packages": [
    "npm:pi-subagents@0.83.1",
    "npm:@juicesharp/rpiv-ask-user-question@2.15.0",
    "npm:@dietrichgebert/ponytail@5.3.2"
  ],
  "subagents": {
    "defaultModel": "rwaltrpi/deepseek-v4.1-flash",
    "defaultSubagentOnlyExtensions": [
      "/var/home/rwaltr/.config/pi/agent/extensions/go-fallback.ts"
    ],
    "defaultThinking": "low",
    "maxThinking": "medium",
    "agentOverrides": {
      "scout": {
        "model": "rwaltrpi/deepseek-v4.1-flash",
        "thinking": "low"
      },
      "delegate": {
        "model": "rwaltrpi/deepseek-v4.1-flash",
        "thinking": "low"
      },
      "researcher": {
        "model": "rwaltrpi/kimi-k3",
        "thinking": "medium"
      },
      "background": {
        "model": "rwaltrpi/kimi-k3",
        "thinking": "medium"
      },
      "worker": {
        "model": "rwaltrpi/glm-5.3",
        "thinking": "medium"
      },
      "evidence-auditor": {
        "model": "rwaltrpi/glm-5.3",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "rwaltrpi/claude-sonnet-5-5",
        "thinking": "medium"
      },
      "oracle": {
        "model": "rwaltrpi/claude-opus-5-5",
        "thinking": "medium"
      }
    },
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "inherit",
        "rwaltrpi/*",
        "agentgateway/*"
      ]
    }
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 1000
  },
  "editor": {
    "multilineShortcut": "shift+enter"
  },
  "messageQueue": {
    "steeringMode": "one-at-a-time",
    "followUpMode": "one-at-a-time"
  },
  "hideThinkingBlock": false
}
