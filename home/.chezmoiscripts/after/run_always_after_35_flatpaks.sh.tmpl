#!/usr/bin/env bash
# vi: ft=sh
# Flatpak install/update is managed by `rwaltrctl flatpaks`.
#
# We intentionally do NOT install/update flatpaks during `chezmoi apply`.
# Curated IDs still live in .chezmoitemplates/flatpaks*.txt.

set -euo pipefail

echo "Skipping flatpak install/update in chezmoi apply."
echo "Use: rwaltrctl flatpaks sync-now"
