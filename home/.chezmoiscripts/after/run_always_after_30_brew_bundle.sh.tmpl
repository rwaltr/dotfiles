#!/usr/bin/env bash
# vi: ft=sh
# Homebrew bundle install/update is managed by `rwaltrctl brew`.
#
# We intentionally do NOT run brew bundle during `chezmoi apply`.
# Curated entries still live in .chezmoitemplates/Brewfile*. 

set -euo pipefail

echo "Skipping brew bundle in chezmoi apply."
echo "Use: rwaltrctl brew sync-now"
